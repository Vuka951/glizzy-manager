# Public origin of the deployment, used for metadata, canonical links,
# robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis for Rivals rooms. Without these the room store falls back to
# an in-memory map, which only works in a single long-lived process (next dev).
# A production server without them prints a warning at startup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lifts the room creation limits (per client per hour, global open rooms) for
# the local test kit. Ignored when NODE_ENV is production.
# CAREER_MP_UNLIMITED=1

# ElevenLabs key for the audio generators under scripts/ (never needed by the
# app). The scripts read it from the shell, not from this file: put it in
# .env.local (gitignored) and load that with `set -a; source .env.local; set +a`
# before `npm run commentary:voices` / `npm run commentary:render`, or prefix
# one command: `XI_API_KEY=... XI_VOICE_ID=... npm run commentary:render`.
XI_API_KEY=
# ElevenLabs voice id the commentary generator renders with. Shortlist with
# `npm run commentary:voices`; a shared voice has to be added to the account
# first (`-- --add <public_user_id> <voice_id>`).
XI_VOICE_ID=
