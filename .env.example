# Public origin of the deployment, used for metadata, canonical links,
# robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis for Rivals rooms. Without these the room store falls back to
# an in-memory map, which only works in a single long-lived process (next dev).
# A production server without them prints a warning at startup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lifts the room creation limits (per client per hour, global open rooms) for
# the local test kit. Ignored when NODE_ENV is production.
# CAREER_MP_UNLIMITED=1

